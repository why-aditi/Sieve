# Copy to backend/.env and fill in. .env is gitignored — never commit a real key.
#
# OPTIONAL. Detection works fully without this: the alias + fuzzy cascade covers
# the known merchants, and unrecognised strings fall back to their cleaned form
# with category "other". Set it to enable step 4 of the §7 cascade.
#
# Get one at https://console.groq.com/keys (free tier is enough for a hackathon).
GROQ_API_KEY=

# Optional override. Groq retires model IDs on short notice; structured outputs
# are supported on openai/gpt-oss-*, moonshotai/kimi-k2-instruct, and Llama 4.
# GROQ_MODEL=openai/gpt-oss-120b
